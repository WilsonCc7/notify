# Postgres — Notify v1 production DB (Docker).
DATABASE_URL="postgresql://notify:notify@localhost:5432/notify"

# Comma-separated allowlist. Gates BOTH password signup and Google login; others hit a blocked page.
ALLOWED_EMAILS="you@school.edu,friend@school.edu"

# Google OAuth — only for optional Link Google. Scopes: openid email profile
# classroom.courses.readonly classroom.coursework.me.readonly (no Gmail/Calendar/Drive)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Signs the session cookie
SESSION_SECRET="dev-only-change-me"

# R2 (Cloudflare) — S3-compatible, 5MB cap. Swap for any S3 endpoint.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
